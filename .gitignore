# 系统生成的垃圾文件
.DS_Store
Thumbs.db
desktop.ini

# 编辑器的个人配置
.vscode/
.idea/

# 依赖包（以后如果引入构建工具才会有）
node_modules/

# 密钥与环境变量 —— 绝对不能提交，进去就删不掉了
.env
.env.local
*.key

# 日志
*.log

# 临时测试文件（AI 调试时产生的网页/输出），不要提交
_*.html
_*.txt
_*.py
_*.json

# RedSkill 成品包（本地产物，不进仓库；要留档走 GitHub Release）
dist/

# 外部数据源（体积大，不进仓库；脚本读这里）
.cache/
